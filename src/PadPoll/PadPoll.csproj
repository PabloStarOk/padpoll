<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <InvariantGlobalization>true</InvariantGlobalization>
        <Configurations>Release;Debug</Configurations>
        <AssemblyName>padpoll</AssemblyName>
        <PublishAot>true</PublishAot>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Version>1.0.0</Version>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DebugType>full</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <OptimizationPreference>Speed</OptimizationPreference>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>
    
    <PropertyGroup>
        <DefineConstants Condition="'$([System.OperatingSystem]::IsLinux())'">LINUX</DefineConstants>
		<DefineConstants Condition="'$([System.OperatingSystem]::IsWindows())'">WINDOWS</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="EvDevSharpWrapper" Version="0.3.0" />
      <PackageReference Include="StyleCop.Analyzers" Version="1.1.118">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <InternalsVisibleTo Include="PadPoll.Tests" />
    </ItemGroup>
    
    <ItemGroup>
        <Compile Remove="Implementations/Linux/**/*.cs" />
        <Compile Include="Implementations/Linux/**/*.cs" Condition="'$([System.OperatingSystem]::IsLinux())'" />
		<Compile Remove="Implementations/Windows/**/*.cs" />
		<Compile Include="Implementations/Windows/**/*.cs" Condition="'$([System.OperatingSystem]::IsWindows())'" />
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    </ItemGroup>
    
</Project>
